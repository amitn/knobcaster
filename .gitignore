# PlatformIO
.pio/
*.bin
*.elf

# ESP-IDF generated (keep sdkconfig.defaults; ignore the rest)
sdkconfig
sdkconfig.knob
sdkconfig.old
managed_components/
dependencies.lock
# Firmware version stamp — written transiently by the Release CI from the tag
# (ESP-IDF reads it for esp_app_get_description()->version). Not committed.
version.txt

# uv / Python
.venv/
__pycache__/
*.pyc

# Local secrets (Wi-Fi credentials etc.)
include/secrets.h
src/secrets.h

# Editors / OS
.DS_Store
*.swp

# Local reference clones (BSPs / analog projects) — never committed
refs/

# Screenshot artifacts from `just shot` / `just uitest`
screen*.png
uitest_shots/
esphome_uitest_shots/
